{
  "app": {
    // 签名配置：**故意不入库**（避免证书路径与 storePassword 外泄）。
    // 在 DevEco Studio 里 File → Project Structure → Signing Configs 勾选
    // 「Automatically generate signature」重新生成一份即可编译运行。
    // 需要手写时参照 build-profile.signing.example.json5。
    "products": [
      {
        "name": "default",
        // 指向上面那份签名配置。你自己的证书配好后把下面这行取消注释即可；
        // 用 DevEco 的「Automatically generate signature」时它会自动补回这一行。
        // "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}