{
  "app": {
    // 仓库版本**不含任何签名材料**（证书路径 / 密码）：需要签名请参考
    // build-profile.signing.example.json5 自行配置。
    // .gitignore 已按扩展名兜底忽略证书文件（*.p12 / *.cer / *.p7b / *.keystore）。
    "products": [
      {
        "name": "default",
        // 指向底部那份签名配置；**缺这一行产物就是未签名的 HAP**，
        // 安装时会报 "no signature file"。
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}