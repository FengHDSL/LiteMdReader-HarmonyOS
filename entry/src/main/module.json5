{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 网络图片：Markdown 正文里的 http/https 图片由 Image 组件直接加载。
    // INTERNET 是 system_grant 权限，声明即可，无需用户授权弹窗。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      // 系统打印（print.print 调起打印预览页）
      {
        "name": "ohos.permission.PRINT"
      },
      // 智感握姿（底部胶囊跟随握持手左右移动）。
      // 设备或授权不支持时静默降级为居中，不影响其它功能——见 service/GripAware.ets。
      {
        "name": "ohos.permission.DETECT_GESTURE",
        "reason": "$string:detect_gesture_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ],
    // 沉浸光感的应用级前置条件。uiMaterial.getMaterialInfo().state 读的就是这一项：
    //   default：普通组件可主动设置材质
    //   enable ：更多系统组件自动使用材质，普通组件仍可主动设置
    //   disable：关闭整个应用的沉浸材质，**主动设置的材质也一并失效**（代码绕不过）
    // 该值打进安装包，改动后必须重新构建安装才生效。
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        // **应用接续（多设备流转）**（用户要求）：跨设备迁移时在 onContinue
        // 携带当前文档与进度，目标端恢复阅读现场
        "continuable": true,
        // **启动方向**（官方 module.json5 → abilities.orientation）：**此前完全没配**——
        // 缺省 unspecified = 由系统判定，**手机上默认锁竖屏**，这就是「锁定竖向、无法横屏」
        // 的根因（代码里从未调用 setPreferredOrientation，配置里也没声明过）。
        // 取值口径（官方枚举）：
        //   · unspecified          → 系统判定（手机默认竖屏）；
        //   · auto_rotation        → **随传感器旋转，不受系统方向锁定影响**（用户要求：允许横竖屏切换）；
        //   · auto_rotation_restricted → 随传感器旋转但尊重系统「自动旋转」开关；
        //   · landscape / portrait → 强制单向。
        // 用户明确要求「允许横竖屏切换」→ 用 auto_rotation（不越过系统设置改回 restricted）。
        // ⚠️ **手机端默认不许横屏**（用户后续要求）：这一项对三种 deviceTypes 是同一个值，
        // 平板 / 2in1 要保留旋转能力，所以手机侧的方向放到运行时按设备类型收紧
        // —— 见 service/AppWindow.ets 的 applyPhoneOrientation()：
        //    phone + 外观设置里「支持横屏模式」关 → PORTRAIT；开关开 → AUTO_ROTATION（与本值一致）。
        "orientation": "auto_rotation",
        // **窗口模式**（官方文档《应用声明支持智慧多窗》）：显式声明全屏 / 分屏 / 悬浮窗三种。
        // 缺省值本来就是这三种，这里显式写出以便后续直接调整；华为侧排查提示的
        // 「放大按钮 / 放大不生效」正是要求 supportWindowMode 含 fullscreen ✓ 已满足。
        "supportWindowMode": ["fullscreen", "split", "floating"],
        // **多窗布局方向（横屏的关键开关）**——官方口径（module.json5 abilities 下）：
        //   · portrait  → 多窗布局竖向，且**手机会话手势分屏「不支持」**；
        //   · landscape → **多窗布局横向**，配置后支持**横向悬浮窗 / 横向全屏**与上下分屏
        //                 （官方建议横向应用配置）← 本应用要的就是这个；
        //   · default   → 竖向悬浮窗（手机）。
        // 历史：曾配 portrait（把协同窗口锁成竖向），改 default 后仍是竖向——
        // 要横屏只能显式 landscape（用户实测：竖屏锁死、无法横屏）。
        "preferMultiWindowOrientation": "landscape",
        // **自由窗口尺寸限制**：最小 320×240（本 SDK 校验只认扁平字段
        // minWindowWidth/minWindowHeight，官方 FAQ 示例的 windowSize 嵌套写法
        // 会被 Schema 校验拒绝——实测）
        "minWindowWidth": 320,
        "minWindowHeight": 240,
        // **自由多窗下的窗口模式与启动形态**（官方《窗口元数据配置》）：
        //   · supportWindowModeInFreeMultiWindow：自由多窗态同样支持 全屏 / 分屏 / 悬浮窗
        //     （缺了它，自由窗标题栏的「放大」按钮不会出现）；
        //   · isMaximize=true：自由窗 / 协同窗口**启动即最大化**（即「协同窗口全屏」）。
        "metadata": [
          {
            "name": "ohos.ability.window.supportWindowModeInFreeMultiWindow",
            "value": "fullscreen,split,floating"
          },
          {
            "name": "ohos.ability.window.isMaximize",
            "value": "true"
          }
        ],
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:starticon_slogan",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          // ── 关联 .md 文件（用户要求）：文件管理器长按 .md →「打开方式」出现澄笺 ──
          // linkFeature: "FileOpen" 大小写敏感；type 用 text/markdown，
          // 若真机把 .md 识别为 text/plain，需再补一条 type: "text/plain" 的 uris。
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "text/markdown",
                "linkFeature": "FileOpen"
              },
              // ── 关联 .txt（用户要求）──
              {
                "scheme": "file",
                "type": "text/plain",
                "linkFeature": "FileOpen"
              },
              // ── 关联 .zip（1.1.1）：**只用于导入备份**（用户要求）——
              // 文件管理器里的备份 zip 长按 →「打开方式」→ 澄笺，直接进导入流程；
              // EntryAbility.handleOpenFile 对 .zip 走 BackupStore.importFromUri，
              // 不支持的压缩包（非澄笺备份结构）会在导入时报错返回。
              {
                "scheme": "file",
                "type": "application/zip",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/x-zip-compressed",
                "linkFeature": "FileOpen"
              }
            ]
          },
          // ── 接收其他应用的「分享」（用户要求：分享到澄笺）──
          // actions 必须是 ohos.want.action.sendData，否则系统不会把分享请求路由过来；
          // uris 里声明能接收的类型 —— 文本（含链接）与 markdown/txt 文件。
          // 被拉起后在 onCreate / onNewWant 里用 systemShare.getSharedData(want) 解析。
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "text/plain"
              },
              {
                "scheme": "file",
                "type": "text/markdown"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      },
      // ── 协同阅读扩展（用户指令：强行接入 UI 扩展组件）──
      // type 用 **embeddedUI**（schema 允许的三方 UI 扩展类型；`uiExtension`
      // 不在枚举里会被编译期 schema 拒绝——实测确认）。提供可被
      // EmbeddedComponent / 协同框架拉起的只读阅读界面，内容来自流转链路。
      {
        "name": "ReaderExtAbility",
        "srcEntry": "./ets/uiextability/ReaderExtAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "type": "embeddedUI",
        "exported": true
      },
      // ── 桌面卡片（2×2 最近阅读卡片，用户要求恢复并新增）──
      // EntryFormAbility 在卡片添加 / 定时刷新时用 FormSync.buildData 组装数据；
      // 即时更新走应用进程侧 FormSync.pushRecents（Reader 进度落盘 / 退后台主动推送）。
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
