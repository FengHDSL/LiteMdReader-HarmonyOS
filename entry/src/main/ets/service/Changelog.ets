/** 最新一条（版本更新弹窗用）。数组为空时返回一个占位条目。 */
export function latestChangelog(): ChangelogEntry {
  if (CHANGELOG_ALL.length === 0) {
    return { version: '', date: '', items: [] };
  }
  return CHANGELOG_ALL[0];
}
